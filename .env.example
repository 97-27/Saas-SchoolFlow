# SUPABASE CONFIGURATION - TEMPLATE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_, ne jamais publier.
# Supabase > Project Settings > API Keys > clé secrète (service_role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clé de signature des sessions (64 caractères aléatoires minimum recommandés).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=generate-a-long-random-secret
